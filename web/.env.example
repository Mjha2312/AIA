# Copy to .env.local and fill in. Never commit .env.local.
# See ../docs/SPEC.md — Ports and env.

# Backend REST API base (SPEC: backend serves JSON under /api)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Serve realistic responses from Next route handlers under /api-mock
# so the UI can be built with no backend running.
NEXT_PUBLIC_USE_MOCKS=true

# Local chain (Hardhat node 8545) — admin wallet only.
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_CHAIN_ID=31337

# Optional admin overrides. Defaults come from
# contracts/deployments/localhost.json via `npm run abi`.
# NEXT_PUBLIC_MULTISIG_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
# NEXT_PUBLIC_ELECTION_MANAGER_ADDRESS=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9